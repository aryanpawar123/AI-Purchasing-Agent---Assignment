# LLM Provider: "anthropic", "openai", or "mock" (no API key needed)
LLM_PROVIDER=mock
LLM_MODEL=claude-sonnet-4-20250514

# API Keys (leave empty for mock mode)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Database
DB_PATH=purchasing_agent.db

# Policy parameters
Z_SCORE=1.65
APPROVAL_THRESHOLD=50000
MAX_COVERAGE_DAYS=30
REVIEW_PERIOD_DAYS=1
PERISHABLE_COVERAGE_FACTOR=0.8

# Server
BACKEND_PORT=8000
FRONTEND_PORT=5173
